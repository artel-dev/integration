<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="ata_exchange_matching_data_view_form" model="ir.ui.view">
        <field name="name">Matching data form view</field>
        <field name="model">ata.exchange.matching.data</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="method_id" readonly="1"/>
                        <field name="ext_system_id" readonly="1"/>
                        <field name="stage" readonly="1"/>
                        <field name="key_object" readonly="1"/>                        
                        <field name="matching_data" readonly="1" widget="jsonb"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ata_exchange_matching_data_view_list" model="ir.ui.view">
        <field name="name">Matching data list view</field>
        <field name="model">ata.exchange.matching.data</field>
        <field name="arch" type="xml">
            <list>
                <field name="method_id"/>
                <field name="stage"/>
                <field name="key_object"/>
                <field name="matching_data"/>
                <field name="ext_system_id"/>
            </list>
        </field>
    </record>

    <record id="ata_exchange_matching_data_action" model="ir.actions.act_window">
        <field name="name">Matching data</field>
        <field name="res_model">ata.exchange.matching.data</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="ata_exchange_matching_data_menu"
            name="Matching data"
            parent="ata_exchange_menu_general"
            action="ata_exchange_matching_data_action"
            sequence="30"
    />

</odoo>